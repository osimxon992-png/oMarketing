# ─────────────────────────────────────────────────────────────
# oMarketing environment. Copy to `.env` and fill in.
# Variables marked REQUIRED must be set for the app to start.
# Everything else enables a feature; the UI tells you when it is missing.
# ─────────────────────────────────────────────────────────────

# REQUIRED — PostgreSQL connection string (Supabase: use the "Session pooler" URI).
# For local dev without Docker run `npm run db:local` and use:
DATABASE_URL="postgresql://sotuvai:sotuvai@localhost:54329/sotuvai"

# REQUIRED — Public base URL of the app, no trailing slash. Must be HTTPS in
# production: Telegram, Meta, Payme and Click call webhooks on this URL.
# For local Telegram testing use a tunnel (e.g. `cloudflared tunnel --url http://localhost:3000`).
APP_URL="http://localhost:3000"

# REQUIRED — 32+ random characters used to sign OAuth state and similar values.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# REQUIRED — 32-byte key, base64, for AES-256-GCM encryption of bot tokens and
# merchant keys at rest. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never change it after data is stored, or stored tokens become unreadable.
ENCRYPTION_KEY=""

# ── AI (Anthropic Claude) ───────────────────────────────────
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=""
# Main sales agent model. Cheaper option: claude-haiku-5-5
AI_MODEL="claude-sonnet-5-5"
# Model used to write rolling conversation summaries.
AI_SUMMARY_MODEL="claude-haiku-5-5"
# low | medium | high — reasoning effort for the sales agent.
AI_EFFORT="low"

# ── Platform Telegram bot (seller notifications + Telegram login) ──
# Create with @BotFather. Then: /setdomain → your APP_URL domain (for the Login Widget).
PLATFORM_BOT_TOKEN=""
PLATFORM_BOT_USERNAME=""
# Random string; Telegram sends it back in X-Telegram-Bot-Api-Secret-Token.
# After setting the bot vars run `npm run telegram:set-notifier-webhook` once.
PLATFORM_BOT_WEBHOOK_SECRET=""

# ── Instagram (Meta) ────────────────────────────────────────
# developers.facebook.com → Create app → "Instagram API with Instagram login".
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
# Any random string; paste the same value in the Meta webhook settings.
META_WEBHOOK_VERIFY_TOKEN=""
META_GRAPH_VERSION="v23.0"

# ── Platform payments (sellers pay for oMarketing subscriptions) ──
# Payme business cabinet → Merchant → "Cashbox" ID and key.
PLATFORM_PAYME_MERCHANT_ID=""
PLATFORM_PAYME_KEY=""
PLATFORM_PAYME_TEST_MODE="true"
# Click merchant cabinet → Service settings.
PLATFORM_CLICK_SERVICE_ID=""
PLATFORM_CLICK_MERCHANT_ID=""
PLATFORM_CLICK_SECRET_KEY=""

# ── Misc ─────────────────────────────────────────────────────
# Telegram username (without @) that sellers are sent to when they press "Pay"
# for a subscription. Confirm the payment afterwards in /admin.
PLATFORM_PAY_TELEGRAM="osimxon_00"
# Owner-only admin panel at /admin/login. Not related to user accounts.
# Leave empty to keep the panel locked. Password: at least 12 characters.
ADMIN_LOGIN=""
ADMIN_PASSWORD=""
# Protects /api/cron/maintenance (call it daily from your scheduler with
# header "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=""
